{
  "name": "claudep",
  "version": "0.1.0",
  "description": "Run Claude Code under separate accounts on one machine (work + personal) with isolated logins and shared config.",
  "type": "module",
  "bin": {
    "claudep": "./claudep.ts"
  },
  "repository": "github:bordoni/claudep",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "test": "bun test --timeout 20000",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
